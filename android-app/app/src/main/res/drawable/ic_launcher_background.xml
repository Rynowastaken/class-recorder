        android:fillColor="#232730"
        android:pathData="M0,0h108v108h-108z" />
    <!-- A single very soft vertical lift, same idea as the page gradient. -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startY="0"
                android:endY="108"
                android:startColor="#2B303C"
                android:endColor="#1B1E25"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>